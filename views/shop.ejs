<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
      }

      body {
        background-color: #f5f7fa;
        color: #333;
      }

      header {
        background-color: #1f2937;
        padding: 1rem 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      nav {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      nav li {
        list-style: none;
      }

      nav a {
        text-decoration: none;
        color: white;
        font-size: 16px;
        padding: 10px 16px;
        border-radius: 6px;
        transition: background-color 0.3s;
      }

      nav a:hover {
        background-color: #374151;
      }

      main {
        max-width: 900px;
        margin: 60px auto;
        background-color: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        text-align: center;
      }

      h1 {
        font-size: 40px;
        margin-bottom: 16px;
        color: #111827;
      }

      p {
        font-size: 18px;
        color: #6b7280;
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <li><a href="/">Shop</a></li>
        <li><a href="/admin/add-product">Add Product</a></li>
      </nav>
    </header>

    <main>
      <h1>My Products</h1>
      <p>List of available products will appear here.</p>
<% prods.forEach((prod) => { %>
  <p><%= prod.title %></p>
<% }) %>
    </main>
  </body>
</html>
