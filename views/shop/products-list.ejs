<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, sans-serif;
      }

      body {
        background-color: #f5f7fa;
        color: #333;
      }

      header {
        background-color: #1f2937;
        padding: 1rem 2rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      }

      nav {
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      nav li {
        list-style: none;
      }

      nav a {
        text-decoration: none;
        color: white;
        font-size: 16px;
        padding: 10px 16px;
        border-radius: 6px;
        transition: background-color 0.3s;
      }

      nav a:hover {
        background-color: #374151;
      }

      main {
        max-width: 900px;
        margin: 60px auto;
        background-color: white;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        text-align: center;
      }

      h1 {
        font-size: 40px;
        margin-bottom: 16px;
        color: #111827;
      }

      p {
        font-size: 18px;
        color: #6b7280;
      }
    </style>
  </head>

  <body>
    <header>
      <nav>
        <li><a href="/">Shop</a></li>
        <li><a href="/products"> Products</a></li>
        <li><a href="/cart"> Cart</a></li>
        <li><a href="/orders"> Orders</a></li>
        <li><a href="/admin/products">Admin Products</a></li>
        <li><a href="/admin/add-product">Add Product</a></li>
      </nav>
    </header>

<style>
  .products-container {
    max-width: 1200px;
    margin: 40px auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    padding: 20px;
  }

  .product-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    transition: 0.3s;
  }

  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .product-card img {
    width: 100%;
    height: 220px;
    object-fit: cover;
  }

  .product-content {
    padding: 20px;
  }

  .product-title {
    font-size: 24px;
    margin-bottom: 10px;
    color: #111827;
  }

  .product-price {
    font-size: 22px;
    font-weight: bold;
    color: #2563eb;
    margin-bottom: 12px;
  }

  .product-description {
    color: #6b7280;
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .product-btn {
    width: 100%;
    padding: 12px;
    border: none;
    background: #2563eb;
    color: white;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
    transition: 0.3s;
  }

  .product-btn:hover {
    background: #1d4ed8;
  }
</style>

<main>
  <h1>My Products</h1>
  <p>List of available products will appear here.</p>

  <div class="products-container">
    <% prods.forEach((prod) => { %>
      <div class="product-card">
        <img src="<%= prod.imageURL %>" alt="<%= prod.title %>">

        <div class="product-content">
          <h2 class="product-title"><%= prod.title %></h2>

          <p class="product-price">$<%= prod.price %></p>

          <p class="product-description">
            <%= prod.description %>
          </p>

    <form action="/add-to-cart" method="post">
            <button type="submit" class="product-btn">
          Add To Cart
          </button>
    </form>
        </div>
      </div>
    <% }) %>
  </div>
</main>
  </body>
</html>
